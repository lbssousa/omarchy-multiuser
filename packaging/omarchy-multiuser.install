# Without these, a second administrator's update fails on the first one's log,
# and the migrations of anyone but the first administrator go unrecorded.
_enable_update_units() {
  systemctl enable --now omarchy-mu-update-log.path >/dev/null 2>&1 || true
  /usr/bin/omarchy-mu-accounts sync-migration-watchers >/dev/null 2>&1 || true
}

post_install() {
  systemd-sysusers omarchy-multiuser.conf
  systemd-tmpfiles --create omarchy-multiuser.conf
  /usr/bin/omarchy-mu-sddm-guard || true
  /usr/bin/omarchy-mu-sddm-sync || true
  _enable_update_units
  echo ":: Enable the watchers and the per-login unit (omarchy-setup does this):"
  echo "   systemctl enable --now omarchy-mu-sddm-guard.path omarchy-mu-sddm-sync.path omarchy-mu-apply-lock.path"
  echo "   systemctl --global enable omarchy-mu-login.service"
  echo ":: Add users to the omarchy-users group; the login screen changes the next time it shows."
  _warn_passwords
  echo ":: With several accounts, lock root's password: omarchy-mu-accounts root-sync"
  echo ":: Switch user appears after logging out once: an automatic login's desktop can't leave for the login screen."
}

# The login screen finds the account by its password alone, so a person needs one,
# nobody else's. Accounts waiting to choose theirs at the login screen can't any more.
_warn_passwords() {
  local waiting
  waiting=$(awk -F: '$2 == "" { print $1 }' /etc/shadow | paste -sd' ' -)
  [[ -z $waiting ]] || echo ":: These accounts have no password and can't log in: $waiting. Run: omarchy-mu-user-password <user>"
  echo ":: Each person's password has to be their own, and also opens the disk. Run omarchy-mu-user-password for each of them."
}

post_upgrade() {
  systemd-tmpfiles --create omarchy-multiuser.conf
  /usr/bin/omarchy-mu-sddm-sync || true
  if (( $(vercmp "$2" 0.7.0) < 0 )); then
    _enable_update_units
  fi
  if (( $(vercmp "$2" 0.10.0) < 0 )); then
    /usr/bin/omarchy-mu-sddm-guard || true
    _warn_passwords
  fi
  # The menu entries follow the language from here on; enabling the login unit
  # brings the watcher along (Also=), but one enabled before needs it now.
  if (( $(vercmp "$2" 0.11.0) < 0 )) && systemctl --global is-enabled --quiet omarchy-mu-login.service 2>/dev/null; then
    systemctl --global enable omarchy-mu-menu-sync.path >/dev/null 2>&1 || true
  fi
}

# Each user's shell runs the lock screen from this package; with it gone and
# omarchy.lock still disabled, it would have none. Their own files, as them.
_restore_lock_screens() {
  local user home
  while IFS=: read -r user _ uid _ _ home shell; do
    (( uid >= 1000 && uid < 60000 )) || continue
    [[ $shell != */nologin && $shell != */false && -d $home ]] || continue
    runuser -u "$user" -- env -u XDG_CONFIG_HOME -u XDG_STATE_HOME HOME="$home" \
      /usr/bin/omarchy-mu-lock-plugin-sync remove >/dev/null 2>&1 ||
      echo ":: Couldn't restore $user's lock screen: run omarchy-mu-lock-plugin-sync remove as them before removing this package." >&2
  done < <(getent passwd)
}

# systemd keeps these links after their unit file is gone, each one dangling.
_disable_migration_watchers() {
  local wants=${1:-/etc/systemd/system/multi-user.target.wants} link
  for link in "$wants"/omarchy-mu-migrate-record@*.path; do
    [[ -L $link ]] || continue
    systemctl disable --now "${link##*/}" >/dev/null 2>&1 || rm -f -- "$link"
  done
}

pre_remove() {
  # First: the guard watches /etc/sddm.conf.d, so cleaning up below would run it,
  # and it would put back the PAM line that is about to go.
  systemctl disable --now omarchy-mu-sddm-guard.path omarchy-mu-sddm-sync.path omarchy-mu-apply-lock.path >/dev/null 2>&1 || true
  systemctl stop omarchy-mu-sddm-guard.service >/dev/null 2>&1 || true
  _restore_lock_screens
  systemctl disable --now omarchy-mu-update-log.path >/dev/null 2>&1 || true
  _disable_migration_watchers
  rm -f /usr/share/sddm/themes/omarchy-multiuser/theme.conf.user
  systemctl --global disable omarchy-mu-login.service omarchy-mu-menu-sync.path >/dev/null 2>&1 || true
  rm -f /etc/sddm.conf.d/zzz-omarchy-mu-autologin.conf
  [[ ! -f /etc/pam.d/sddm ]] || sed -i '/\/usr\/bin\/omarchy-mu-login-\(match\|once\)/d' /etc/pam.d/sddm
  rm -f /run/omarchy-multiuser/login-once
}

post_remove() {
  echo ":: SDDM goes back to Omarchy's greeter at the next login screen."
  echo ":: Each person's disk key stays on the disk; /etc/omarchy-multiuser/slots says whose is whose."
  echo ":: Autologin stays off; Omarchy's tools turn it back on if you want it."
}
