#!/bin/bash

# omarchy:summary=Change a password: the login, the lock screen and the disk together
#
# Each account's password also opens the disk and tells the machine who you are,
# so plain passwd leaves the disk key behind. Administrators can change anyone's,
# with their own password; everyone else their own.
#
# Usage: omarchy-mu-user-password [<user>]

set -euo pipefail

# shellcheck source=../lib/omarchy-multiuser/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/common.sh"

me=$(id -un)
user=${1:-}
if [[ -z $user ]]; then
  if omu_is_admin; then
    mapfile -t candidates < <(omu_human_users)
    user=$(gum choose --header "Change whose password?" "${candidates[@]}") || exit 1
  else
    user=$me
  fi
fi
[[ $user == "$me" ]] || omu_is_admin || omu_die "Only an administrator can change someone else's password."

new_password=$(omu_ask_new_password "New password for $user") || exit 1
own=$(gum input --password --header "Your password ($me), the current one") || exit 1

if omu_is_admin; then
  sudo -v
  if [[ $user == "$me" ]]; then
    printf '%s\n%s\n' "$own" "$new_password" | sudo omarchy-mu-user-helper password-self
  else
    printf '%s\n%s\n' "$own" "$new_password" | sudo omarchy-mu-user-helper password "$user"
  fi
else
  printf '%s\n%s\n' "$own" "$new_password" | sudo -n omarchy-mu-user-helper password-self
fi
omu_info "$user's password changed, for the login screen, the lock screen and the disk."
