#!/bin/bash

# omarchy:summary=Keep the multi-user entries in your Omarchy menu extensions
# omarchy:hidden=true
#
# The Omarchy menu merges ~/.config/omarchy/extensions/omarchy-menu.jsonc
# over its own definition, entry by entry (an existing id keeps the fields it
# isn't given). This keeps share/menu-block.jsonc there between two marker
# comments, right before the file's closing brace, replacing an older copy and
# leaving everything else alone. /etc/skel's copy belongs to omarchy-settings,
# so instead of seeding it, omarchy-mu-menu-sync.service (enabled globally)
# runs this at every login: new users get the block on their first one.
#
# The menu translates only its own rows (default/i18n/<code>/menu.json), never
# an extension's, so the block's labels are written here in the language
# Omarchy shows (~/.config/omarchy/language, as omarchy-i18n reads it), from
# share/menu-labels.json, with the English label kept as a search term the way
# the menu keeps it for its own rows. A language it lacks, or none, is English.
# omarchy-mu-menu-sync.path runs this again when the language changes.
#
# Usage: omarchy-mu-menu-sync [file]

set -euo pipefail

# shellcheck source=../lib/omarchy-multiuser/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/common.sh"

file=${1:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/extensions/omarchy-menu.jsonc}
block=$OMU_SHARE/menu-block.jsonc
begin='// >>> omarchy-multiuser (managed: omarchy-mu-menu-sync rewrites this block)'
end='// <<< omarchy-multiuser'

[[ -f $block ]] || omu_die "Missing $block"

language_file=${OMARCHY_LANGUAGE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/language}
language=en
if [[ -f $language_file ]]; then
  read -r language <"$language_file" || true
  language=${language//[[:space:]]/}
  [[ $language =~ ^[a-z]{2,3}(-[A-Za-z]{2})?$ ]] || language=en
fi

translated=$(mktemp)
trap 'rm -f "$translated"' EXIT
# shellcheck disable=SC2016  # Perl, not shell
perl -CSD -MJSON::PP -e '
  my ($catalog_file, $language) = @ARGV;
  my $labels = {};
  if (open my $fh, "<:encoding(UTF-8)", $catalog_file) {
    local $/;
    my $catalog = eval { JSON::PP->new->decode(<$fh>) } || {};
    $labels = $catalog->{$language} if ref $catalog->{$language} eq "HASH";
  }
  my $json = JSON::PP->new->allow_nonref;
  while (my $line = <STDIN>) {
    if ($line =~ /^\s*"([^"]+)":\s*\{/ && defined(my $label = $labels->{$1})) {
      $line =~ s{"label":("(?:[^"\\]|\\.)*")}{
        my $english = $1;
        $label eq $json->decode($english) ? "\"label\":$english"
          : "\"label\":" . $json->encode($label) . ",\"searchTerms\":[$english]"
      }e;
    }
    print $line;
  }' "$OMU_SHARE/menu-labels.json" "$language" <"$block" >"$translated"

if [[ ! -f $file ]]; then
  mkdir -p "$(dirname "$file")"
  if [[ -f /etc/skel/.config/omarchy/extensions/omarchy-menu.jsonc ]]; then
    cp /etc/skel/.config/omarchy/extensions/omarchy-menu.jsonc "$file"
  else
    printf '{\n}\n' >"$file"
  fi
fi

new=$(awk -v begin="$begin" -v end="$end" -v blockfile="$translated" '
  function out(line) { result[++n] = line }
  function emit_block(   line, j) {
    # The entry before the block needs its comma, or the JSON breaks.
    for (j = n; j > 0; j--) {
      if (result[j] ~ /^[[:space:]]*(\/\/.*)?$/) continue
      if (result[j] !~ /[,{][[:space:]]*$/) result[j] = result[j] ","
      break
    }
    out("  " begin)
    while ((getline line < blockfile) > 0) out(line)
    close(blockfile)
    out("  " end)
  }
  { lines[NR] = $0 }
  END {
    # The closing brace: the last line that is just "}".
    for (i = NR; i > 0; i--) if (lines[i] ~ /^[[:space:]]*}[[:space:]]*$/) { close_at = i; break }
    if (!close_at) { print "omarchy-mu-menu-sync: no closing brace" > "/dev/stderr"; exit 2 }
    skipping = 0
    for (i = 1; i <= NR; i++) {
      line = lines[i]
      if (index(line, ">>> omarchy-multiuser")) { skipping = 1; continue }
      if (skipping) { if (index(line, "<<< omarchy-multiuser")) skipping = 0; continue }
      if (i == close_at) emit_block()
      out(line)
    }
    for (i = 1; i <= n; i++) print result[i]
  }' "$file")

if [[ $(<"$file") != "$new" ]]; then
  printf '%s\n' "$new" | omu_atomic_write "$file" 644
fi
