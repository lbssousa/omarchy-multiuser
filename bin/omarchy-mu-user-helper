#!/bin/bash

# omarchy:summary=Root's side of changing passwords: the login and the disk key together
# omarchy:requires-sudo=true
# omarchy:hidden=true
#
# Called through sudo; authorises every request itself, by SUDO_USER and nothing
# from the arguments. Passwords come on stdin, one per line, never in argv.
#
#   check-new            new password   may this be someone's next password?
#   password <user>      caller's password, new password   (administrators)
#   password-self        caller's password, new password   (anyone, for themselves;
#                        sudoers grants it to omarchy-users without a password, and
#                        three tries an hour keep it from being a way to test guesses)
#   forget <user>        take the account's key off the disk   (administrators)
#   finish               finish a change that stopped part way   (administrators)
#
# Usage: omarchy-mu-user-helper check-new|password <user>|password-self|forget <user>|finish

set -euo pipefail
set +x

# shellcheck source=../lib/omarchy-multiuser/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/common.sh"
# shellcheck source=../lib/omarchy-multiuser/slots.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/slots.sh"

if (( EUID != 0 )) && [[ -z $OMU_ROOT ]]; then
  exec sudo "$0" "$@"
fi
umask 077

caller=${SUDO_USER:-}
omu_human_users | grep -qx -- "$caller" || omu_die "Run this through sudo, from a person's account."

require_admin() {
  omu_is_admin "$caller" || omu_die "Only an administrator can do that."
}

require_person() {
  omu_human_users | grep -qx -- "${1:-}" || omu_die "There is no user named ${1:-}."
}

# Three an hour, counted whether or not they go through.
self_allowed() {
  local state now recent
  mkdir -p "$OMU_RATE_DIR"
  state=$OMU_RATE_DIR/$(getent passwd "$caller" | cut -d: -f3)
  now=$(date +%s)
  recent=""
  [[ ! -f $state ]] || recent=$(awk -v since=$(( now - 3600 )) '$1 > since' "$state")
  if (( $(grep -c . <<<"$recent") >= 3 )); then
    omu_die "That's three password changes this hour. Try again later, or ask an administrator."
  fi
  { [[ -z $recent ]] || printf '%s\n' "$recent"; echo "$now"; } >"$state"
}

read_secrets() {
  IFS= read -r caller_password || [[ -n ${caller_password:-} ]] || omu_die "No password given."
  IFS= read -r new_password || [[ -n ${new_password:-} ]] || omu_die "No new password given."
}

omu_hold_lock slots || omu_die "Another password change is in progress."
omu_load_drive || exit 1

action=${1:-}
case $action in
  check-new)
    require_admin
    IFS= read -r new_password || [[ -n ${new_password:-} ]] || omu_die "No password given."
    omu_check_new_password "$new_password" ""
    ;;
  password)
    require_admin
    require_person "${2:-}"
    read_secrets
    omu_slots_finish
    omu_slots_change_password "$caller" "$2" "$new_password" "$caller_password"
    ;;
  password-self)
    omu_is_admin "$caller" || self_allowed
    read_secrets
    omu_slots_finish
    omu_slots_change_password "$caller" "$caller" "$new_password" "$caller_password"
    ;;
  forget)
    require_admin
    require_person "${2:-}"
    omu_slots_finish
    omu_slots_forget "$2"
    ;;
  finish)
    require_admin
    omu_slots_finish
    ;;
  *) omu_die "Usage: omarchy-mu-user-helper check-new|password <user>|password-self|forget <user>|finish" ;;
esac
