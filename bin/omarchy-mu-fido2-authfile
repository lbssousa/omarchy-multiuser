#!/bin/bash

# omarchy:summary=Add or remove the calling user's FIDO2 keys in the shared pam_u2f authfile
# omarchy:requires-sudo=true
# omarchy:hidden=true
#
# Usage (through sudo, as the omarchy-users sudoers rule allows, or pkexec):
#   pamu2fcfg -u "$USER" | sudo omarchy-mu-fido2-authfile add
#   sudo omarchy-mu-fido2-authfile remove
#   echo <key handle> | pkexec omarchy-mu-fido2-authfile remove-key
#   omarchy-mu-fido2-authfile has [user]        (no root needed)
#
# Omarchy keeps one authfile, /etc/fido2/fido2, with a line per user
# ("user:credential[:credential...]"); upstream's setup writes the whole file
# for whoever runs it. This helper only ever touches one line: the one of the
# user sudo or pkexec says called it (SUDO_USER, PKEXEC_UID), never a name
# from the arguments or stdin. An administrator (sudo or pkexec from a wheel
# member, or a root shell) may pass --user to act on someone else's line, as
# omarchy-mu-user-remove does; the omarchy-users sudoers rule only allows the
# bare `add` and `remove`.
#
# pkexec is how security-key-omarchy's overlay, which has no terminal for
# sudo, saves a key: the org.omarchy-multiuser.fido2-authfile action asks for
# the user's own password, as sudo does.

set -euo pipefail

# shellcheck source=../lib/omarchy-multiuser/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/common.sh"

action=${1:-}
shift || true

# Who called, as sudo or pkexec tells it.
caller=${SUDO_USER:-}
if [[ -z $caller && -n ${PKEXEC_UID:-} ]]; then
  caller=$(getent passwd "$PKEXEC_UID" | cut -d: -f1) || true
  [[ -n $caller ]] || omu_die "Unknown caller (uid $PKEXEC_UID)."
fi

target=$caller
if [[ ${1:-} == --user ]]; then
  if [[ -n $caller ]]; then
    omu_is_admin "$caller" || omu_die "--user is only for administrators."
  else
    (( EUID == 0 )) || omu_die "--user is only for administrators."
  fi
  target=${2:-}
fi

authfile=$OMU_FIDO2_AUTHFILE
authdir=$(dirname "$authfile")

valid_user() {
  [[ $1 =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] && getent passwd "$1" >/dev/null
}

# Lines of the authfile other than <user>'s.
others() {
  [[ -f $authfile ]] || return 0
  awk -F: -v u="$1" '$1 != u && NF > 0' "$authfile"
}

current() {
  [[ -f $authfile ]] || return 0
  awk -F: -v u="$1" '$1 == u' "$authfile"
}

check_authdir() {
  if [[ -L $authdir || ( -e $authdir && ! -d $authdir ) ]]; then
    omu_die "$authdir is not a FIDO2 configuration directory."
  fi
  if [[ -L $authfile || ( -e $authfile && ! -f $authfile ) ]]; then
    omu_die "$authfile is not a FIDO2 registration file."
  fi
}

do_add() {
  local user=$1 input creds line existing
  # One line, as pamu2fcfg -u prints it: "<user>:<credential>[:<credential>]".
  input=$(head -c 65536)
  input=${input%$'\n'}
  [[ $input != *$'\n'* ]] || omu_die "Expected a single pamu2fcfg line."
  [[ ! $input =~ [[:cntrl:]] ]] || omu_die "The pamu2fcfg line has control characters."
  [[ $input == "$user:"?* ]] || omu_die "The pamu2fcfg line is not for $user."
  creds=${input#"$user:"}
  [[ $creds =~ ^[A-Za-z0-9+/=,_.:-]+$ ]] || omu_die "The pamu2fcfg line is malformed."

  existing=$(current "$user")
  if [[ -n $existing ]]; then
    line=$existing
    local cred
    IFS=':' read -r -a new_creds <<<"$creds"
    for cred in "${new_creds[@]}"; do
      [[ -n $cred ]] || continue
      # Same key registered again: keep one copy.
      if [[ ":${line#"$user:"}:" != *":$cred:"* ]]; then
        line+=":$cred"
      fi
    done
  else
    line="$user:$creds"
  fi

  install -d -m 755 "$authdir"
  { others "$user"; printf '%s\n' "$line"; } | omu_atomic_write "$authfile" 644
  echo "FIDO2 key registered for $user."
}

# Drops the one credential whose key handle (its first field) comes on stdin;
# the line goes with its last credential.
do_remove_key() {
  local user=$1 handle existing cred kept=()
  handle=$(head -c 4096)
  handle=${handle%$'\n'}
  [[ $handle =~ ^[A-Za-z0-9+/=_-]+$ ]] || omu_die "Expected one key handle."
  existing=$(current "$user")
  [[ -n $existing ]] || omu_die "No FIDO2 keys registered for $user."
  IFS=':' read -r -a creds <<<"${existing#"$user:"}"
  for cred in "${creds[@]}"; do
    [[ -n $cred && ${cred%%,*} != "$handle" ]] && kept+=("$cred")
  done
  (( ${#kept[@]} < ${#creds[@]} )) || omu_die "No such key registered for $user."
  {
    others "$user"
    (( ${#kept[@]} == 0 )) || (IFS=':'; printf '%s\n' "$user:${kept[*]}")
  } | omu_atomic_write "$authfile" 644
  echo "FIDO2 key removed for $user."
}

do_remove() {
  local user=$1 rest
  [[ -f $authfile ]] || { echo "No FIDO2 keys registered."; return 0; }
  rest=$(others "$user")
  if [[ -n $rest ]]; then
    printf '%s\n' "$rest" | omu_atomic_write "$authfile" 644
  else
    : | omu_atomic_write "$authfile" 644
  fi
  echo "FIDO2 keys removed for $user."
  [[ -n $rest ]] || echo "empty"
}

case $action in
  has)
    user=${1:-$(id -un)}
    [[ -n $(current "$user") ]]
    ;;
  add|remove|remove-key)
    (( EUID == 0 )) || omu_die "Run through sudo: sudo omarchy-mu-fido2-authfile $action"
    [[ -n $target ]] || omu_die "Can't tell which user called (no SUDO_USER or PKEXEC_UID)."
    valid_user "$target" || omu_die "Unknown user: $target"
    check_authdir
    omu_with_lock fido2 "do_${action//-/_}" "$target"
    ;;
  *)
    echo "Usage: omarchy-mu-fido2-authfile {add|remove|remove-key|has [user]}" >&2
    exit 2
    ;;
esac
