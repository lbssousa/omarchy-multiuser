#!/bin/bash

# omarchy:summary=Remove a user account from this Omarchy machine
# omarchy:requires-sudo=true
#
# Also removes what the multi-user setup keeps for that user outside their
# home: their FIDO2 line, fingerprints, LUKS keyslot and migration watcher, and
# the sudo grants that would outlive them (the installer's by name,
# omarchy-sudo-passwordless' by UID, which a later account could be given).
# Refuses system accounts, the account running it and the last administrator.
# Every question comes before anything changes. omarchy-mu-user-helper removes
# the account as one journaled change that only goes forward: a stop part way is
# finished by the next run. When root's password was theirs, it becomes yours,
# which is why it asks for your password.
#
# Usage: omarchy-mu-user-remove [<user>] [--keep-home|--delete-home]
# Without either option it asks what to do with the home directory.

set -euo pipefail

# shellcheck source=../lib/omarchy-multiuser/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/common.sh"

omu_is_admin || omu_die "Only an administrator can remove users."
omu_hold_lock accounts || omu_die "Another account change is in progress."

user="" home_choice=""
for arg in "$@"; do
  case $arg in
    --keep-home) home_choice=keep ;;
    --delete-home) home_choice=delete ;;
    -*) omu_die "Unknown option: $arg" ;;
    *) user=$arg ;;
  esac
done

if [[ -z $user ]]; then
  mapfile -t candidates < <(omu_human_users | grep -vx "$(id -un)")
  (( ${#candidates[@]} )) || omu_die "There is no other user to remove."
  user=$(gum choose --header "Remove which user?" "${candidates[@]}") || exit 1
fi

getent passwd "$user" >/dev/null || omu_die "No such user: $user"
omu_human_users | grep -x -- "$user" >/dev/null || omu_die "$user is a system account."
[[ $user != "$(id -un)" ]] || omu_die "You can't remove your own account."
if omu_is_admin "$user"; then
  omu_admins | grep -vx -- "$user" >/dev/null || omu_die "$user is the last administrator."
fi

home=$(getent passwd "$user" | cut -d: -f6)
if [[ -z $home_choice ]]; then
  status=0
  gum confirm --default=false "Delete $user's files in $home too?" || status=$?
  case $status in
    0) home_choice=delete ;;
    1) home_choice=keep ;;
    *) exit 1 ;;
  esac
fi

# omarchy-drive-password needs this note to finish a disk password change that
# stopped part way, and keeps it in the home of whoever started the change.
note=$home/.local/state/omarchy/drive-password.state
if [[ $home_choice == delete ]] && sudo test -e "$OMU_ROOT$note"; then
  omu_die "$home holds the note of an unfinished disk password change ($note); finish it first, or use --keep-home."
fi

if [[ $home_choice == keep ]]; then
  what="(keeping the home directory)"
else
  what="and DELETE their home directory"
fi
gum confirm --default=false "Remove $user $what?" || exit 1
# Once Omarchy ships its own Setup › Users, its omarchy-user-delete removes the
# account and asks for your password itself.
upstream=false
if omu_upstream_users; then
  upstream=true
else
  own_password=$(gum input --password --header "Your password ($(id -un)), the current one") || exit 1
  printf '%s\n' "$own_password" | sudo omarchy-mu-user-helper verify || exit 1
fi

# userdel refuses while the account has programs running, so ask now.
sign_out=false
if omu_has_programs "$user"; then
  gum confirm --default=false "$user has programs running. Log them out and end those programs?" || exit 1
  sign_out=true
fi

# Otherwise lingering would start a user manager again, and would pass to a
# later account given the name.
sudo loginctl disable-linger "$user" 2>/dev/null || true
if $sign_out; then
  omu_sign_out "$user" || omu_die "$user still has programs running; nothing was removed. Try again in a moment."
fi

sudo omarchy-mu-fido2-authfile remove --user "$user" >/dev/null 2>&1 || true
sudo fprintd-delete "$user" >/dev/null 2>&1 || true
helper_args=("$user")
[[ $home_choice == delete ]] && helper_args+=(--delete-home)
if $upstream; then
  "$OMU_UPSTREAM_BIN/omarchy-user-delete" "${helper_args[@]}" || omu_die "$user wasn't removed."
else
  printf '%s\n' "$own_password" | sudo omarchy-mu-user-helper delete "${helper_args[@]}" ||
    omu_die "Couldn't remove $user. Run this again, or finish with: sudo omarchy-mu-user-helper finish"
fi

# The account is gone: what depends on that happens even if its home isn't.
sudo omarchy-mu-apply-lock --quiet || true
sudo omarchy-mu-accounts sync-migration-watchers ||
  echo "Warning: run sudo omarchy-mu-accounts sync-migration-watchers to finish." >&2
omu_info "Removed $user."
