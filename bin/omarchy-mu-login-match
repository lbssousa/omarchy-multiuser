#!/bin/bash -p

# omarchy:summary=End a login attempt whose password belongs to another account, from SDDM's PAM stack
# omarchy:hidden=true
#
# The login screen asks for a password alone and tries each account in turn, as
# the disk prompt does. This runs first in SDDM's auth stack, as
# `[success=die default=ignore]`: it succeeds, ending the attempt, only when the
# password is another account's, so trying the wrong account first costs neither
# pam_unix's delay nor a failed-login strike. A password that is nobody's, and any
# failure of this script, fall through to the usual stack and count as before.

set -uo pipefail
set +x
[[ -n ${OMU_ROOT:-} ]] || export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
umask 077

# shellcheck source=../lib/omarchy-multiuser/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/common.sh" || exit 1
# shellcheck source=../lib/omarchy-multiuser/slots.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/slots.sh" || exit 1

(( EUID == 0 )) || [[ -n $OMU_ROOT ]] || exit 1
[[ ${PAM_TYPE:-} == auth ]] || exit 1
user=${PAM_USER:-}
[[ $user =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || exit 1

# pam_exec's expose_authtok hands over the password ending in a NUL.
password=""
IFS= read -r -d '' password || [[ -n $password ]] || exit 1

# A stalled lookup must not hold every login: past the deadline this ends
# nonzero, which leaves the attempt to the usual stack.
( sleep 10; pkill -KILL -P $$; kill -KILL $$ ) 2>/dev/null &
watchdog=$!

# Only an owner with no failed logins on record ends the attempt early. A locked
# owner's password then takes the same slow refusal as any wrong one, so a fast
# refusal never tells a guesser what a lockout is hiding.
match() {
  local owner
  omu_password_matches "$password" "$user" && return 1
  owner=$(omu_password_owner "$password") || return 1
  [[ $owner != "$user" ]] && ! omu_has_failed_logins "$owner"
}

match
status=$?
kill "$watchdog" 2>/dev/null
exit "$status"
