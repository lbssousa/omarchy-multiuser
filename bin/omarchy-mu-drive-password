#!/bin/bash

# omarchy:summary=Change the password of an encrypted data drive; the system disk's follow each person's
#
# On a machine where each account's password is its own key slot on the system disk
# (/etc/omarchy-multiuser exists), changing the system disk's password with
# omarchy-drive-password would leave someone's login password and disk key apart.
# Omarchy's PR refuses the system disk there; this does the same for Update ›
# Password › Drive Encryption, offering only the other encrypted drives:
# omarchy-drive-password picks a drive through omarchy-drive-select, which this
# puts first on its PATH with the system disk left out. Anywhere else it runs
# omarchy-drive-password as it is, which stays at hand in a terminal to make a
# login password and the disk's the same before the first account is added.
#
# Usage: omarchy-mu-drive-password

set -euo pipefail

# shellcheck source=../lib/omarchy-multiuser/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/common.sh"
# shellcheck source=../lib/omarchy-multiuser/slots.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/slots.sh"

if [[ ${1:-} == --select ]]; then
  # Stands in for omarchy-drive-select: its argument is the list of drives.
  shift
  others=$(while read -r d; do
    [[ -z $d || $(readlink -f "$d") == "$OMU_SELECT_SKIP" ]] || printf '%s\n' "$d"
  done <<<"${1:-}")
  [[ -n $others ]] || exit 0
  if (( $(wc -l <<<"$others") == 1 )); then
    printf '%s\n' "$others"
  else
    PATH=$OMU_SELECT_PATH exec omarchy-drive-select "$others"
  fi
  exit
fi

system=$(omu_root_luks_device 2>/dev/null) || system=""
if [[ -z $system || ! -d $OMU_SLOT_DIR ]]; then
  exec omarchy-drive-password "$@"
fi

drives=$(lsblk -nrpo NAME,FSTYPE | awk '$2 == "crypto_LUKS" && !seen[$1]++ { print $1 }' |
  while read -r d; do readlink -f "$d"; done | grep -vxF -- "$system" || true)
if [[ -z $drives ]]; then
  echo "The system disk opens with each person's own password. Change yours under Setup › Users › Change Password."
  echo "There is no other encrypted drive."
  exit 1
fi

echo "The system disk opens with each person's own password (Setup › Users › Change Password), so only the other encrypted drives are offered here."
shim=$(mktemp -d)
trap 'rm -rf "$shim"' EXIT
printf '#!/bin/bash\nexec %q --select "$@"\n' "$(readlink -f "$0")" >"$shim/omarchy-drive-select"
chmod +x "$shim/omarchy-drive-select"
outer_path=$PATH
OMU_SELECT_SKIP=$system OMU_SELECT_PATH=$outer_path PATH=$shim:$outer_path omarchy-drive-password "$@"
