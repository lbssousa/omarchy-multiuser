#!/bin/bash

# omarchy:summary=Per-login multi-user upkeep for the current user
# omarchy:hidden=true
#
# Run by omarchy-mu-login.service (a user unit the package enables globally,
# so every account gets it, including ones created later):
#
#   - keeps the multi-user block in the Omarchy menu (omarchy-mu-menu-sync);
#   - keeps the bar's update icon for administrators only
#     (omarchy-mu-update-widget-sync);
#   - invites the user to enroll a fingerprint when the machine has a reader
#     and they have none. Upstream's first-run invitation only fires while
#     /etc/pam.d/omarchy-lock-fingerprint is missing, i.e. never for anyone
#     after the first user to enroll.

set -uo pipefail

omarchy-mu-menu-sync || echo "omarchy-mu-menu-sync failed" >&2
omarchy-mu-update-widget-sync || echo "omarchy-mu-update-widget-sync failed" >&2

if command -v fprintd-list >/dev/null && omarchy-hw-fingerprint 2>/dev/null; then
  if fprintd-list "$USER" 2>&1 | grep -qi 'has no fingers enrolled' &&
    omarchy-done ensure mu-fingerprint-invitation; then
    omarchy-notification-wait || true
    omarchy-notification-send -u normal -g 󰈷 "Setup Fingerprint Reader" \
      "Use your fingerprint for sudo and unlocking." \
      --exec omarchy-launch-floating-terminal-with-presentation omarchy-mu-setup-security-fingerprint || true
  fi
fi
exit 0
