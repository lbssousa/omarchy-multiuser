#!/bin/bash
# omarchy:summary=Exit 0 when the current user is an administrator (wheel)
# omarchy:hidden=true
# Used by the multi-user menu block to show admin-only rows. Without a user,
# this session's groups, which are what sudo goes by.
if (( $# )); then
  id -nG "$1" 2>/dev/null
else
  id -nG
fi | tr ' ' '\n' | grep -qx wheel
