#!/bin/bash

# omarchy:summary=Add a user account to this Omarchy machine
# omarchy:requires-sudo=true
#
# Omarchy is provisioned for a single owner (omarchy-provision-owner). This
# adds another account the same way that owner's was finalized: /etc/skel
# seeds the dotfiles (and marks every existing migration done), the full name
# goes to GECOS, which the multi-user greeter lists, and Omarchy's per-user
# provisioning (omarchy-provision-user, as provision-owner's finalize_user
# runs it) sets the theme, git identity and keyring up before the first login.
#
# With a second person on the machine, root's password (the owner's, from
# omarchy-provision-owner) is locked before the account exists, so a stop
# part way leaves more protection, not less. The new account gets the lowest
# UID that owns nothing in /home, and an administrator gets the %wheel sudo
# rule when an ISO install granted the owner sudo by name only, and the watcher
# that records the migrations it runs.
#
# The password is asked here and goes in last: the account stays locked until
# everything else is done. It is also the account's own key to the disk, and what
# picks the account at the disk prompt and the login screen, so it must be nobody
# else's. Adding that key takes your own password.
#
# Usage: omarchy-mu-user-add [<user> --full-name <name>] [--email <address>]
#                            [--admin] [--shell <path>] [--groups g1,g2]
# Without a user name it asks for everything.

set -euo pipefail

# shellcheck source=../lib/omarchy-multiuser/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/common.sh"

omu_is_admin || omu_die "Only an administrator can add users."
omu_hold_lock accounts || omu_die "Another account change is in progress."

user="" full_name="" email="" admin=false shell=/bin/bash groups=""
while (($#)); do
  case $1 in
    --full-name) full_name=${2:-}; shift 2 ;;
    --email) email=${2:-}; shift 2 ;;
    --admin) admin=true; shift ;;
    --shell) shell=${2:-}; shift 2 ;;
    --groups) groups=${2:-}; shift 2 ;;
    -h|--help) sed -n '3,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
    -*) omu_die "Unknown option: $1" ;;
    *) user=$1; shift ;;
  esac
done

if [[ -z $user ]]; then
  user=$(gum input --placeholder "username (lowercase)" --header "New user") || exit 1
  full_name=$(gum input --placeholder "Full name, as the login screen shows it" --header "Full name") || exit 1
  email=$(gum input --placeholder "e-mail (optional, for git)" --header "E-mail") || exit 1
  gum confirm --default=false "Make $user an administrator (wheel)?" && admin=true
fi

[[ $user =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || omu_die "Invalid user name: $user"
getent passwd "$user" >/dev/null && omu_die "User $user already exists."
getent group "$user" >/dev/null && omu_die "A group named $user already exists."
# useradd would keep it, owned by the account it was kept for (the new one
# never gets that UID), and the new account couldn't use its own home.
[[ ! -e $OMU_HOME_DIR/$user ]] || omu_die "$OMU_HOME_DIR/$user already exists; move it aside first (sudo mv $OMU_HOME_DIR/$user $OMU_HOME_DIR/$user.old)."
# It outranks zz-omarchy-multiuser.conf: the first person would keep being logged
# in automatically, at every boot, with a second one on the machine.
! omu_fixed_autologin || omu_die "/etc/sddm.conf logs someone in automatically; remove User= from its [Autologin] section first."
[[ -n ${full_name//[[:space:]]/} ]] || omu_die "A full name is required (the login screen lists it)."
[[ $full_name != *[:,]* && $full_name != *$'\n'* ]] || omu_die "The full name can't contain ':' ',' or line breaks."
[[ -x $shell ]] || omu_die "No such shell: $shell"
grep -qx "$shell" /etc/shells || omu_die "$shell is not listed in /etc/shells."

group_list=$OMU_USERS_GROUP
$admin && group_list+=",$OMU_ADMIN_GROUP"
[[ -n $groups ]] && group_list+=",$groups"

uid=$(omu_free_uid) || omu_die "No free UID left."

# Before anything changes: a password someone else has stops here.
new_password=$(omu_ask_new_password "$user's password") || exit 1
own_password=$(gum input --password --header "Your password ($(id -un)), the current one") || exit 1
sudo -v
printf '%s\n' "$new_password" | sudo omarchy-mu-user-helper check-new || exit 1

sudo groupadd -f "$OMU_USERS_GROUP"
$admin && sudo omarchy-mu-accounts ensure-wheel-sudo
sudo omarchy-mu-accounts lock-root
sudo useradd --create-home --uid "$uid" --comment "$full_name" --shell "$shell" --groups "$group_list" "$user"
omu_info "Created $user ($full_name)."

home=$(getent passwd "$user" | cut -d: -f6)
echo "Preparing $user's Omarchy setup..."
sudo runuser -u "$user" -- env \
  HOME="$home" USER="$user" LOGNAME="$user" SHELL="$shell" \
  OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}" \
  OMARCHY_INSTALL="${OMARCHY_PATH:-/usr/share/omarchy}/install" \
  OMARCHY_SETUP_CONTEXT=provision-owner \
  OMARCHY_USER_NAME="$full_name" \
  OMARCHY_USER_EMAIL="$email" \
  OMARCHY_LOG_TO_STDOUT=1 \
  omarchy-provision-user --force --first-install ||
  echo "Omarchy's per-user setup didn't finish; it runs again at $user's first login." >&2

# After that setup, which marks every migration done without running any: the
# watcher must set those markers aside.
if $admin; then
  sudo omarchy-mu-accounts sync-migration-watchers ||
    echo "Warning: the migrations $user runs won't be recorded; run: sudo omarchy-mu-accounts sync-migration-watchers" >&2
fi

if ! printf '%s\n%s\n' "$own_password" "$new_password" | sudo omarchy-mu-user-helper password "$user"; then
  omu_die "$user has no password yet, so nobody can log in as them. Run: omarchy-mu-user-password $user"
fi

omu_info "\n$user can now log in by typing their password, at the disk prompt or the login screen."
