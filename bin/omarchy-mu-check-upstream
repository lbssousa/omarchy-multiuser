#!/bin/bash

# omarchy:summary=Warn when Omarchy files the multi-user forks are based on change
# omarchy:hidden=true
#
# share/upstream.sha256 lists the installed Omarchy files each fork started
# from (upstream/ in the source tree). Run by a pacman hook after Omarchy
# upgrades: a changed file means upstream moved and the fork should be
# reviewed (`just diff-upstream` in the omarchy-multiuser checkout).

set -uo pipefail

# shellcheck source=../lib/omarchy-multiuser/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/common.sh"

sums=$OMU_SHARE/upstream.sha256
[[ -f $sums ]] || exit 0

mapfile -t changed < <(cd / && sha256sum --quiet --check "$sums" 2>/dev/null | sed -n 's/: FAILED.*$//p')
if (( ${#changed[@]} )); then
  echo "omarchy-multiuser: Omarchy changed files its forks are based on; review them:"
  printf '  /%s\n' "${changed[@]}"
fi
exit 0
