#!/bin/bash

# omarchy:summary=Root's side of adding and removing accounts: sudo grants and the root password
# omarchy:requires-sudo=true
# omarchy:hidden=true
#
# omarchy-provision-owner gives root the owner's password and, on an ISO
# install, archinstall grants the owner sudo by name. Both assume one person.
# omarchy-mu-user-add and -remove call this as root:
#
#   ensure-wheel-sudo  write %wheel ALL=(ALL:ALL) ALL (00-omarchy-wheel, what
#                      omarchy-provision-owner writes) when it is missing, so
#                      a second administrator gets sudo on an ISO install too
#   drop-grants <user> delete what gives <user> sudo outside wheel: the
#                      installer's NN_<user> grant and omarchy-sudo-passwordless'
#                      99-omarchy-*nopasswd-<uid> rules, which name the UID and
#                      would pass to the next account given it; then warn
#                      about other sudoers rules naming <user>
#   check-root <user>  fail, saying why, when <user> outside wheel still
#                      reaches root: a sudo rule for every command, whatever
#                      it names (a group, say), or the docker group
#   sync-migration-watchers
#                      omarchy-mu-migrate-record@<admin>.path enabled for
#                      every administrator and for nobody else; the markers
#                      an administrator already has by then are set aside, since
#                      an account's first setup marks every migration done
#                      without running any, except for the machine's first
#   lock-root          lock root's password: with several people, whoever
#                      knew the owner's password would reach root without
#                      being in wheel
#   root-sync          lock-root with two or more accounts; with one, give
#                      root that account's password hash back (the installer's
#                      setup), but only when it is the caller's and an
#                      administrator's
#
# Usage: omarchy-mu-accounts ensure-wheel-sudo|drop-grants <user>|check-root <user>|
#                            sync-migration-watchers|lock-root|root-sync

set -euo pipefail

# shellcheck source=../lib/omarchy-multiuser/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/common.sh"
# shellcheck source=../lib/omarchy-multiuser/migrations.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/migrations.sh"

if (( EUID != 0 )) && [[ -z $OMU_ROOT ]]; then
  exec sudo "$0" "$@"
fi

ensure_wheel_sudo() {
  local file=$OMU_SUDOERS_DIR/00-omarchy-wheel
  [[ -f $file ]] && return 0
  echo "%$OMU_ADMIN_GROUP ALL=(ALL:ALL) ALL" | omu_atomic_write "$file" 440
  if [[ -z $OMU_ROOT ]] && ! visudo -cqf "$file"; then
    rm -f -- "$file"
    omu_die "visudo rejected $file; not granting $OMU_ADMIN_GROUP sudo."
  fi
  echo "Administrators ($OMU_ADMIN_GROUP) can now use sudo."
}

# The rule archinstall writes for its users, alone in NN_<user>.
installer_grant() {
  local file=$1 user=$2 rules
  rules=$(grep -vE '^[[:space:]]*(#|$)' "$file") || return 1
  [[ $rules == "$user ALL=(ALL) ALL" || $rules == "$user ALL=(ALL:ALL) ALL" ]]
}

drop_grants() {
  local user=$1 uid file
  uid=$(getent passwd "$user" | cut -d: -f3)
  [[ -n $uid ]] || omu_die "No such user: $user"

  for file in "$OMU_SUDOERS_DIR"/[0-9][0-9]_"$user"; do
    [[ -f $file ]] || continue
    if installer_grant "$file" "$user"; then
      rm -f -- "$file"
      echo "Removed the installer's sudo grant for $user (${file##*/})."
    fi
  done
  for file in "$OMU_SUDOERS_DIR/99-omarchy-nopasswd-$uid" "$OMU_SUDOERS_DIR/99-omarchy-permanent-nopasswd-$uid"; do
    if [[ -e $file || -L $file ]]; then
      rm -f -- "$file"
      echo "Removed $user's passwordless sudo (${file##*/})."
    fi
  done

  for file in "$OMU_SUDOERS_DIR"/* "$OMU_ROOT/etc/sudoers"; do
    [[ -f $file ]] || continue
    if grep -vE '^[[:space:]]*#' "$file" | grep -qwF -- "$user"; then
      echo "Warning: ${file#"$OMU_ROOT"} still names $user; check it with visudo." >&2
    fi
  done
}

check_root() {
  local user=$1 privileges status=0
  # An account sudo doesn't know answers with text, whatever the exit status.
  privileges=$(sudo -l -U "$user" 2>/dev/null) || true
  if [[ -z $privileges ]]; then
    echo "Warning: couldn't ask sudo what $user may run; check with sudo -l -U $user." >&2
    status=1
  # Root among the users it may run as, with any group after them, any tags
  # (NOPASSWD:, SETENV:...) and any exceptions after a comma, still runs
  # anything else as root.
  elif grep -qE '^[[:space:]]+\(([^):]*,[[:space:]]*)?(ALL|root)([[:space:]]*,[^):]*)?([[:space:]]*:[^)]*)?\) ([A-Z_]+:[[:space:]]*)*ALL(,|$)' <<<"$privileges"; then
    echo "Warning: another sudo rule still gives $user full sudo; see sudo -l -U $user." >&2
    status=1
  fi
  if omu_in_group "$user" docker; then
    echo "Warning: $user is in the docker group, which is as good as root (gpasswd -d $user docker)." >&2
    status=1
  fi
  return "$status"
}

# Each administrator's markers are how the machine learns a migration ran, so
# one without a watcher could update and leave the others waiting for good.
# The enabled instances are read from WantedBy's symlinks.
#
# omarchy-provision-user --first-install marks every migration done without
# running any, and an account outside wheel skips the privileged parts, so what
# an account has marked by the time it becomes an administrator says nothing
# about the machine. omarchy-mu-migrate-record ignores those markers. The first
# administrator has nobody to wait for: the machine's history is theirs.
take_baseline() {
  local user=$1 wants=$2 file=$OMU_MIGRATION_BASELINES/$1 home markers
  [[ ! -e $file ]] || return 0
  if ! compgen -G "$wants/omarchy-mu-migrate-record@*.path" >/dev/null &&
    ! compgen -G "$OMU_MIGRATION_REGISTRY/*" >/dev/null; then
    return 0
  fi
  home=$(getent passwd "$user" | cut -d: -f6)
  markers=$OMU_ROOT$home/.local/state/omarchy/migrations
  install -d -m 755 "$OMU_MIGRATION_BASELINES" || return 1
  { find "$markers" -maxdepth 1 -type f -printf '%f\n' 2>/dev/null || true; } | omu_atomic_write "$file" 644
}

sync_migration_watchers() {
  local wants=$OMU_ROOT/etc/systemd/system/multi-user.target.wants link unit user file status=0
  # Becoming an administrator again sets aside what was marked in between.
  for file in "$OMU_MIGRATION_BASELINES"/*; do
    [[ -f $file ]] || continue
    omu_is_admin "${file##*/}" || rm -f -- "$file" || status=1
  done
  for link in "$wants"/omarchy-mu-migrate-record@*.path; do
    [[ -L $link ]] || continue
    unit=${link##*/}
    user=${unit#*@}
    user=${user%.path}
    if ! omu_is_admin "$user"; then
      systemctl disable --now --quiet "$unit" || status=1
    fi
  done
  while read -r user; do
    unit=omarchy-mu-migrate-record@$user.path
    if [[ ! -L $wants/$unit ]]; then
      if take_baseline "$user" "$wants"; then
        systemctl enable --now --quiet "$unit" || status=1
      else
        status=1
      fi
    fi
  done < <(omu_admins)
  return "$status"
}

root_hash() {
  getent shadow root | cut -d: -f2
}

root_locked() {
  local hash
  hash=$(root_hash)
  [[ -n $hash && ( $hash == '!'* || $hash == '*'* ) ]]
}

lock_root() {
  root_locked && return 0
  usermod -L root
  root_locked || omu_die "Couldn't lock root's password."
  echo "Locked root's password; administrators use sudo."
}

root_sync() {
  local users hash
  mapfile -t users < <(omu_human_users)
  if (( ${#users[@]} != 1 )); then
    lock_root
    return 0
  fi
  root_locked || return 0
  local user=${users[0]}
  if [[ $user != "${SUDO_USER:-}" ]] || ! omu_group_members "$OMU_ADMIN_GROUP" | grep -qx "$user"; then
    echo "Root stays locked: the one account left ($user) didn't ask for its password to be root's."
    return 0
  fi
  hash=$(getent shadow "$user" | cut -d: -f2)
  if [[ -z $hash || $hash == '!'* || $hash == '*'* ]]; then
    echo "Root stays locked: $user has no usable password."
    return 0
  fi
  # chpasswd -e reads the hash on stdin, so it never shows up in ps.
  printf 'root:%s\n' "$hash" | chpasswd -e
  echo "Root has $user's password again, as with a single owner."
}

case ${1:-} in
  ensure-wheel-sudo) ensure_wheel_sudo ;;
  drop-grants)
    [[ -n ${2:-} ]] || omu_die "Usage: omarchy-mu-accounts drop-grants <user>"
    drop_grants "$2"
    ;;
  check-root)
    [[ -n ${2:-} ]] || omu_die "Usage: omarchy-mu-accounts check-root <user>"
    check_root "$2"
    ;;
  sync-migration-watchers) sync_migration_watchers ;;
  lock-root) lock_root ;;
  root-sync) root_sync ;;
  *) omu_die "Usage: omarchy-mu-accounts ensure-wheel-sudo|drop-grants <user>|check-root <user>|sync-migration-watchers|lock-root|root-sync" ;;
esac
