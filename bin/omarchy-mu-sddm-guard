#!/bin/bash

# omarchy:summary=Keep SDDM on the multi-user greeter, with only the automatic login it chooses
# omarchy:requires-sudo=true
# omarchy:hidden=true
#
# Omarchy logs its single owner in automatically: omarchy-provision-owner and
# omarchy-upgrade-to-quattro write /etc/sddm.conf.d/autologin.conf, and unencrypted
# installs get a self-deleting omarchy-provision-autologin-once.service. Who is
# logged in is omarchy-mu-login-select's to say, at each SDDM start, so this removes
# both, and checks the result. It also keeps omarchy-mu-login-once's two lines and
# then omarchy-mu-login-match first in SDDM's PAM stack, where an upgrade of sddm
# may leave a new /etc/pam.d/sddm without them, and takes login-match out once
# Omarchy ships its own (omarchy-login-match).
#
# Run by omarchy-mu-sddm-guard.path when /etc/sddm.conf.d changes and by the
# pacman hook. Never restarts sddm, which would end every open session.
#
# Usage: omarchy-mu-sddm-guard [--check]

set -euo pipefail

# shellcheck source=../lib/omarchy-multiuser/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/omarchy-multiuser/common.sh"

check=false
[[ ${1:-} == --check ]] && check=true
problems=0

# Before the first auth line, whatever its indentation; only an active line counts.
login_match="auth        [success=die default=ignore] pam_exec.so quiet expose_authtok /usr/bin/omarchy-mu-login-match"
pam=$OMU_PAM_DIR/sddm
if omu_upstream_users; then
  # Omarchy's own omarchy-login-match does the same, and two would check every
  # password twice.
  if [[ -f $pam ]] && grep -q '/usr/bin/omarchy-mu-login-match' "$pam"; then
    if $check; then
      echo "login-match: ours is still in $pam, next to Omarchy's" >&2
      problems=1
    else
      sed -i '\|/usr/bin/omarchy-mu-login-match|d' "$pam"
      echo "Took omarchy-mu-login-match out of $pam: Omarchy has its own."
    fi
  fi
elif [[ -f $pam ]] && ! grep -Eq '^[[:space:]]*auth[[:space:]].*/usr/bin/omarchy-mu-login-match' "$pam"; then
  if $check; then
    echo "login-match: not in $pam" >&2
    problems=1
  elif grep -Eq '^[[:space:]]*-?auth[[:space:]]' "$pam"; then
    sed -E -i "0,/^[[:space:]]*-?auth[[:space:]]/s||$login_match\n&|" "$pam"
    echo "Added omarchy-mu-login-match to $pam."
  else
    echo "No auth line in $pam; the login screen will count a wrong account as a failed login." >&2
  fi
fi

# Right before login-match, in this order, each once.
login_once="auth        [success=done default=ignore] pam_exec.so quiet expose_authtok /usr/bin/omarchy-mu-login-once"
login_empty="auth        [success=die default=ignore] pam_exec.so quiet expose_authtok /usr/bin/omarchy-mu-login-once --empty"
login_once_in_place() {
  awk -v once="$login_once" -v empty="$login_empty" '
    /\/usr\/bin\/omarchy-mu-login-once/ { if ($0 == once) n_once++; else if ($0 == empty) n_empty++; else bad = 1 }
    /^[[:space:]]*auth[[:space:]].*\/usr\/bin\/omarchy-mu-login-match/ && !match_at { match_at = NR }
    { lines[NR] = $0 }
    END {
      if (bad || n_once != 1 || n_empty != 1 || match_at < 3) exit 1
      exit !(lines[match_at - 2] == once && lines[match_at - 1] == empty)
    }' "$1"
}
if [[ -f $pam ]] && grep -Eq '^[[:space:]]*auth[[:space:]].*/usr/bin/omarchy-mu-login-match' "$pam" &&
  ! login_once_in_place "$pam"; then
  if $check; then
    echo "login-once: not right before login-match in $pam" >&2
    problems=1
  else
    sed -i '/\/usr\/bin\/omarchy-mu-login-once/d' "$pam"
    sed -E -i "0,/^[[:space:]]*auth[[:space:]].*\/usr\/bin\/omarchy-mu-login-match/s||$login_once\n$login_empty\n&|" "$pam"
    echo "Added omarchy-mu-login-once to $pam."
  fi
fi

autologin=$OMU_SDDM_CONF_DIR/autologin.conf
if [[ -e $autologin || -L $autologin ]]; then
  if $check; then
    echo "autologin: $autologin exists" >&2
    problems=1
  else
    rm -f -- "$autologin"
    echo "Removed $autologin."
  fi
fi

once_unit=$OMU_ROOT/etc/systemd/system/omarchy-provision-autologin-once.service
if [[ -e $once_unit ]] && ! $check; then
  [[ -n $OMU_ROOT ]] || systemctl disable omarchy-provision-autologin-once.service >/dev/null 2>&1 || true
  rm -f -- "$once_unit"
  echo "Removed omarchy-provision-autologin-once.service."
fi

# SDDM reads /etc/sddm.conf.d/*.conf in name order, then /etc/sddm.conf; the
# last value of a key wins. Report what the effective theme and autologin
# user are, leaving out the automatic login omarchy-mu-login-select chose.
effective() {
  local section=$1 key=$2 file value=""
  local files=("$OMU_SDDM_CONF_DIR"/*.conf "$OMU_ROOT/etc/sddm.conf")
  for file in "${files[@]}"; do
    [[ -f $file && $file != "$OMU_SDDM_AUTOLOGIN" ]] || continue
    local v
    v=$(awk -F= -v s="[$section]" -v k="$key" '
      /^\[/ { insec = ($0 == s) }
      insec && $1 == k { sub(/^[^=]*=/, ""); val = $0; found = 1 }
      END { if (found) print "=" val }' "$file")
    [[ -n $v ]] && value=${v#=}
  done
  printf '%s\n' "$value"
}

theme=$(effective Theme Current)
user=$(effective Autologin User)

if [[ $theme != "$OMU_THEME" ]]; then
  echo "SDDM theme is '${theme:-<default>}', not $OMU_THEME." >&2
  problems=1
fi
if [[ -n $user ]]; then
  echo "SDDM still logs '$user' in automatically (check /etc/sddm.conf)." >&2
  problems=1
fi

exit "$problems"
