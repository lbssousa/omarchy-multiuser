# omarchy-multiuser: what users outside wheel may do as root.
#
# Their own line in the shared FIDO2 authfile (the helper takes the user from
# SUDO_USER and nothing else); asks for the user's own password. Only the
# bare actions: --user is for administrators.
%omarchy-users ALL=(root) /usr/bin/omarchy-mu-fido2-authfile add, /usr/bin/omarchy-mu-fido2-authfile remove
# Their own password: the login and the disk key together. The helper takes the
# user from SUDO_USER, asks for the current password on stdin, and allows three
# tries an hour.
%omarchy-users ALL=(root) NOPASSWD: /usr/bin/omarchy-mu-user-helper password-self
# Recompute the lock screen's fingerprint PAM after enrolling or deleting
# prints. Idempotent; its only options are --check and --quiet.
%omarchy-users ALL=(root) NOPASSWD: /usr/bin/omarchy-mu-apply-lock "", /usr/bin/omarchy-mu-apply-lock --quiet, /usr/bin/omarchy-mu-apply-lock --check
# A child's lock screen also opens with an administrator's password: the helper
# answers only for a child, one try at a time, rate limited and logged, and takes
# the password on stdin.
%omarchy-child ALL=(root) NOPASSWD: /usr/bin/omarchy-mu-user-helper adult-check
