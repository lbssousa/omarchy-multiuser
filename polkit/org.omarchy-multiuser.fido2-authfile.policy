<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  omarchy-multiuser: `pkexec omarchy-mu-fido2-authfile`, for the security key
  overlay (security-key-omarchy), which has no terminal for sudo. Like the
  omarchy-users sudoers rule, it asks for the user's own password: the helper
  only touches the caller's line (PKEXEC_UID), and the user option stays with
  administrators. 10-omarchy-multiuser.rules refuses it to anyone outside
  wheel and omarchy-users.
-->
<policyconfig>
  <vendor>omarchy-multiuser</vendor>
  <vendor_url>https://github.com/lbssousa/omarchy-multiuser</vendor_url>

  <action id="org.omarchy-multiuser.fido2-authfile">
    <description>Register or remove your FIDO2 security keys</description>
    <message>Authentication is required to save your security keys for sudo and polkit</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/omarchy-mu-fido2-authfile</annotate>
  </action>
</policyconfig>
