  // Per-user security setup (omarchy-multiuser): each user registers their own
  // FIDO2 key and fingerprints; machine-wide parts stay with administrators.
  // fingerprint-omarchy's and security-key-omarchy's overlays when the shell
  // has them (from their packages or `omarchy plugin add`); they don't touch
  // PAM, which the terminal scripts still set up for administrators. The
  // security key overlay saves through omarchy-mu-fido2-authfile (pkexec).
  "setup.security.fingerprint": {"action":"[[ $(omarchy-shell shell summon lbssousa.fingerprint '{}' 2>/dev/null) == ok ]] || omarchy-launch-floating-terminal-with-presentation omarchy-mu-setup-security-fingerprint"},
  "setup.security.fido2": {"action":"[[ $(omarchy-shell shell summon lbssousa.security-key '{}' 2>/dev/null) == ok ]] || omarchy-launch-floating-terminal-with-presentation omarchy-mu-setup-security-fido2"},
  "remove.security.fingerprint": {"action":"omarchy-launch-floating-terminal-with-presentation omarchy-mu-remove-security-fingerprint"},
  "remove.security.fido2": {"when":"omarchy-pkg-present pam-u2f && omarchy-mu-fido2-authfile has","action":"omarchy-launch-floating-terminal-with-presentation omarchy-mu-remove-security-fido2"},
  // System updates need an administrator; everyone else applies their migrations.
  "update.omarchy": {"action":"omarchy-launch-floating-terminal-with-presentation omarchy-mu-update"},
  // Machine-wide: the greeter recolor, packages, services, sudo and the disk
  // password are administrators' business.
  "appearance.unlock": {"when":"omarchy-mu-is-admin"},
  "install": {"when":"omarchy-mu-is-admin"},
  "setup.security.sshd": {"when":"omarchy-mu-is-admin"},
  "setup.security.sudoless-docker": {"when":"omarchy-mu-is-admin && omarchy-sudo-docker --configured"},
  "setup.security.passwordless-sudo": {"when":"omarchy-mu-is-admin"},
  "remove.security.sshd": {"when":"omarchy-mu-is-admin && systemctl is-enabled --quiet sshd"},
  "remove.security.sudoless-docker": {"when":"omarchy-mu-is-admin && ! omarchy-sudo-docker --configured"},
  // Data drives only once each person's password is their own key to the system disk.
  "update.password.drive": {"when":"omarchy-mu-is-admin","action":"omarchy-launch-floating-terminal-with-presentation omarchy-mu-drive-password"},
  // The login password is also the account's disk key: plain passwd leaves it behind.
  // Changed under Setup › Users, as Omarchy's PR does.
  "update.password.user": {"when":"false"},
  // Omarchy 4.6 folds Update > Password into one entry that re-keys the system
  // disk and then the login (omarchy-drive-password --login), as if the disk had
  // one owner. Here it changes this person's login and their own key slot. In
  // 4.5 the entry is a submenu, which menu-sync leaves alone.
  "update.password": {"action":"omarchy-launch-floating-terminal-with-presentation omarchy-mu-user-password"},
  // Removing software drops packages for everyone. What lives in the user's
  // own home (themes, web apps, TUIs, the Windows VM, mise dev envs, Microsoft
  // and Xbox Cloud web apps, the SSH agent) stays theirs.
  "remove.package": {"when":"omarchy-mu-is-admin"},
  "remove.ai": {"when":"omarchy-mu-is-admin"},
  "remove.dictation": {"when":"omarchy-mu-is-admin && (omarchy-pkg-present voxtype-bin || omarchy-pkg-present superwhisper-bin || omarchy-pkg-present hex-bin)"},
  "remove.cli": {"when":"omarchy-mu-is-admin"},
  "remove.gaming.moonlight": {"when":"omarchy-mu-is-admin && omarchy-pkg-present moonlight-qt"},
  // Wipes the machine, everyone's home included. Setup > Reset Computer in 4.5.
  "setup.reset": {"when":"omarchy-mu-is-admin && [[ $(findmnt -no FSTYPE /) == btrfs ]]"},
  "remove.factory-reset": {"when":"omarchy-mu-is-admin && [[ $(findmnt -no FSTYPE /) == btrfs ]]"},
  "remove.browser": {"when":"omarchy-mu-is-admin"},
  "remove.preinstalls": {"when":"omarchy-mu-is-admin && [[ ! -f $HOME/.local/state/omarchy/preinstalls-removed ]]"},
  "remove.service.dropbox": {"when":"omarchy-mu-is-admin && omarchy-pkg-present dropbox"},
  "remove.service.tailscale": {"when":"omarchy-mu-is-admin && omarchy-pkg-present tailscale"},
  "remove.gaming.steam": {"when":"omarchy-mu-is-admin && omarchy-pkg-present steam"},
  "remove.gaming.retroarch": {"when":"omarchy-mu-is-admin && omarchy-pkg-present retroarch"},
  "remove.gaming.minecraft": {"when":"omarchy-mu-is-admin && omarchy-pkg-present minecraft-launcher"},
  "remove.gaming.geforce-now": {"when":"omarchy-mu-is-admin && flatpak info com.nvidia.geforcenow"},
  "remove.gaming.xbox-controllers": {"when":"omarchy-mu-is-admin && omarchy-pkg-present xpadneo-dkms"},
  "remove.gaming.lutris": {"when":"omarchy-mu-is-admin && omarchy-pkg-present lutris"},
  "remove.gaming.heroic": {"when":"omarchy-mu-is-admin && omarchy-pkg-present heroic-games-launcher-bin"},
  "remove.development.php.php": {"when":"omarchy-mu-is-admin && ([[ -d $HOME/.local/share/mise/installs/php ]] || omarchy-pkg-present php)"},
  "remove.development.php.symfony": {"when":"omarchy-mu-is-admin && omarchy-pkg-present symfony-cli"},
  "remove.development.ocaml": {"when":"omarchy-mu-is-admin && [[ -d $HOME/.opam ]]"},
  // The machine's clock, time zone, release channel, boot kernel, firmware,
  // boot splash, trackpad driver, hostname and boot snapshots.
  "setup.network.hostname": {"when":"omarchy-mu-is-admin"},
  "system.snapshots": {"when":"omarchy-mu-is-admin && [[ $(omarchy-boot-backend) == systemd-boot ]] && [[ -n $(omarchy-snapshot list) ]]"},
  "system.snapshots.restore": {"when":"omarchy-mu-is-admin && grep -q '/[.]snapshots/[0-9]*/snapshot' /proc/cmdline && [[ $(omarchy-boot-backend) == systemd-boot ]]"},
  "update.channel": {"when":"omarchy-mu-is-admin"},
  "update.kernel": {"when":"omarchy-mu-is-admin && (( $(omarchy-kernel list | wc -l) > 1 ))"},
  "update.firmware": {"when":"omarchy-mu-is-admin"},
  // Omarchy 4.5.0 has it under Update; later releases moved it to Setup > Region,
  // whose Language and Formats stay each person's own.
  "update.timezone": {"when":"omarchy-mu-is-admin"},
  "setup.region.timezone": {"when":"omarchy-mu-is-admin"},
  "update.time": {"when":"omarchy-mu-is-admin"},
  "update.config.plymouth": {"when":"omarchy-mu-is-admin"},
  "update.hardware.trackpad": {"when":"omarchy-mu-is-admin"},
  // Everyone, once there is someone to switch to.
  "system.switch-user": {"icon":"󰀙","label":"Switch User","when":"omarchy-mu-user-switch --available","action":"omarchy-mu-user-switch"},
  // Accounts: everyone changes their own password here, administrators anyone's and
  // the rest. The menu's search doesn't look at the parent's `when`, so each entry
  // has its own.
  "setup.users": {"icon":"","label":"Users"},
  "setup.users.add": {"icon":"","label":"Add User","when":"omarchy-mu-is-admin","action":"omarchy-launch-floating-terminal-with-presentation omarchy-mu-user-add"},
  "setup.users.remove": {"icon":"","label":"Remove User","when":"omarchy-mu-is-admin","action":"omarchy-launch-floating-terminal-with-presentation omarchy-mu-user-remove"},
  "setup.users.admin": {"icon":"󰟵","label":"Administrator Rights","when":"omarchy-mu-is-admin","action":"omarchy-launch-floating-terminal-with-presentation omarchy-mu-user-admin"},
  "setup.users.apps": {"icon":"󰀻","label":"Blocked Apps","when":"omarchy-mu-is-admin","action":"omarchy-launch-floating-terminal-with-presentation omarchy-mu-user-apps"},
  "setup.users.password": {"icon":"","label":"Change Password","action":"omarchy-launch-floating-terminal-with-presentation omarchy-mu-user-password"},
  // This machine's per-user setup (omarchy-setup), when it is installed.
  "setup.omarchy-setup": {"icon":"","label":"Omarchy Setup","when":"command -v omarchy-setup-user","action":"omarchy-launch-floating-terminal-with-presentation omarchy-setup-user"},
